# Python
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/

# Node
node_modules/
dist/
.vite/

# Env
.env
.env.local
# Test-mode Stripe credentials. Nothing loads this file on its own (the backend reads only .env),
# so a test-mode run has to ask for it, and a plain run only ever sees the key in .env.
.env.test

# Locally stored uploads (notes photos/PDFs) — see Note.storage_path
backend/data/

# OS
.DS_Store

# IDE
.vscode/
.idea/

# Design-handoff comparison harness: rendered screenshots and the playwright symlink.
# The scripts and the handoff bundle itself are kept; their output is regenerable.
design/handoff/out/
design/handoff/node_modules/

# TypeScript incremental build state — machine-local, regenerated by `tsc -b`.
frontend/tsconfig.tsbuildinfo

# Generated blog HTML — `npm run blog` renders frontend/content/blog/*.md into here, and the
# `prebuild` hook regenerates it on every build. The markdown is the source; this is output.
# Needs the frontend/ prefix: a pattern containing a slash is anchored to this file's directory.
frontend/public/blog/
frontend/public/sitemap.xml
design/design-system/.render/
design/incoming/
frontend/_plotcheck.html
