# Runs scripts/deploy.sh once: ships main if it has moved, and does nothing otherwise. Started by
# rekall-deploy.timer. A user unit, installed as the user that runs Rekall; see the README's
# Deploying section. Logs: journalctl --user -u rekall-deploy
[Unit]
Description=Ship Rekall's main branch if it has moved

[Service]
Type=oneshot
# Optional: REKALL_RESTART, REKALL_URL and the rest (see the top of scripts/deploy.sh), and PATH
# if node or npm come from somewhere a login shell adds, like nvm: systemd doesn't read profiles.
EnvironmentFile=-%h/.config/rekall/deploy.env
# Assumes the checkout is ~/Rekall. Edit this line if it isn't.
ExecStart=%h/Rekall/scripts/deploy.sh
# A oneshot waits forever by default, and a hung install would hold the deploy lock with it.
TimeoutStartSec=20min
