# Runs scripts/deploy.sh once: ships main if it has moved, and does nothing otherwise. Started by
# rekall-deploy.timer. A user unit, installed as the user that runs Rekall; see the README's
# Deploying section. Logs: journalctl --user -u rekall-deploy
[Unit]
Description=Ship Rekall's main branch if it has moved

[Service]
Type=oneshot
# Through /bin/bash rather than the script's own #! line, so the script starts whatever PATH the
# user manager has. Its settings, PATH included, are in ~/.config/rekall/deploy.env, which the
# script reads itself; see the top of scripts/deploy.sh. Assumes the checkout is ~/Rekall: edit
# this line if it isn't.
ExecStart=/bin/bash %h/Rekall/scripts/deploy.sh
# A oneshot waits forever by default. A run stopped by this is picked up and put right by the next.
TimeoutStartSec=20min
