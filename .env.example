DATABASE_URL=postgresql+psycopg://pipcards:pipcards@localhost:5432/pipcards
# Both Google keys are required. With either blank the app signs every visitor in as one shared
# dev user — fine locally, a wide-open door anywhere else.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SESSION_SECRET=change-me

# The account that can reach the owner-only usage dashboard and the /bug command.
OWNER_EMAIL=

# Which grader runs answer checking.
#   local  — qwen2.5:7b via Ollama on this machine. Free and fastest (~0.15s to first token).
#            Exists so grading need not depend on a metered API; the hosted deployment currently
#            runs `cloud`. The prompt carries extra scaffolding to compensate for a 7B model.
#   cloud  — Gemini 2.5 Flash via OpenRouter. ~0.62s to first token, better writing, ~$0.50 per
#            user per month at 200 reviews/day. Needs OPENROUTER_API_KEY.
#   stub   — fuzzy string match, no model. For tests and offline work.
GRADER=local

OPENROUTER_API_KEY=
CARTESIA_API_KEY=
GROQ_API_KEY=
DEEPGRAM_API_KEY=
