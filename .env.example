DATABASE_URL=postgresql+psycopg://pipcards:pipcards@localhost:5432/pipcards
# Both Google keys are required. With either blank the app signs every visitor in as one shared
# dev user — fine locally, a wide-open door anywhere else.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Where Google sends people back after signing in. It must match a redirect URI registered for
# the client above, character for character. The default is the live site's.
OAUTH_REDIRECT_URI=https://rekall.study/api/auth/callback
# Signs the session cookie. Anyone who knows it can forge a sign-in as any account, so anywhere
# but your own machine it must be a long random value.
SESSION_SECRET=change-me

# The account that can reach the owner-only usage dashboard and the /bug command.
OWNER_EMAIL=

# Which grader runs answer checking.
#   local      — qwen2.5:7b via Ollama on this machine. Free and fastest (~0.14s to first token).
#                Exists so grading need not depend on a metered API; the hosted deployment
#                currently runs `cloud`.
#   cloud      — Gemini 2.5 Flash via OpenRouter, on the same prompt as `local`. ~0.62s to first
#                token, better writing, ~$0.50 per user per month at 200 reviews/day. Needs
#                OPENROUTER_API_KEY; without one, grading quietly runs on `local` instead.
#   prometheus — Prometheus 2 judges and qwen2.5:7b rewords the verdict, both via Ollama. Kept
#                for comparison.
#   stub       — fuzzy string match, no model. For tests and offline work.
GRADER=local
OLLAMA_BASE_URL=http://127.0.0.1:11434

# The tutor's model: openrouter, ollama (qwen2.5:7b), or stub — a canned reply and no network.
TUTOR_PROVIDER=openrouter

# The tutor, cloud grading, the tutor's memory, and card generation and note transcription —
# those last two always go through OpenRouter, whatever the settings above say.
OPENROUTER_API_KEY=

# Voice. Live transcription is always Deepgram. STT_PROVIDER only affects the audio-upload
# endpoint, which the app no longer calls: `local` runs faster-whisper on this machine, and any
# other value, the default included, sends the recording to Groq.
DEEPGRAM_API_KEY=
STT_PROVIDER=deepgram
GROQ_API_KEY=
# The tutor's spoken voice: cartesia or inworld, each with its own key (or chatterbox, a local
# server at TTS_BASE_URL).
TTS_PROVIDER=cartesia
CARTESIA_API_KEY=
INWORLD_API_KEY=

# Payments. A test key in development, a live one in production. Stripe webhooks are refused
# while the secret is blank.
STRIPE_KEY=
STRIPE_WEBHOOK_SECRET=

# What the plan includes each day: pages of notes turned into cards, and answers graded by AI.
GENERATION_PAGES_PER_DAY=30
AI_GRADES_PER_DAY=500

# Where uploaded note files are kept, on local disk.
NOTES_STORAGE_DIR=./data/notes
